<!doctype html>
<html lang="{{ request.locale.iso_code }}"{% if settings.enable_dark_mode %} class="dark-ok"{% endif %}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  {%- if settings.favicon %}<link rel="icon" href="{{ settings.favicon | image_url: width: 64 }}">{% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Marcellus&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;1,6..72,300;1,6..72,400&family=Figtree:wght@400;500;600&display=swap">
  <style>
    :root {
      --paper: {{ settings.color_paper }};
      --paper-2: {{ settings.color_paper_2 }};
      --ink: {{ settings.color_ink }};
      --sage: {{ settings.color_accent }};
    }
  </style>
  {{ 'heirloom.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-password">
  <main id="MainContent">
    {{ content_for_layout }}
  </main>
</body>
</html>
