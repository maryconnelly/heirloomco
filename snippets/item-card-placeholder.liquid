{%- comment -%} Placeholder card shown before a collection with products is chosen. {%- endcomment -%}
<article class="item" data-kind="{{ kind | handleize }}">
  <div class="item-img"><span class="caps">Photo</span></div>
  <span class="caps kind">{{ kind }}</span>
  <h3 class="name">Item name</h3>
  <p class="meta">Short description of the piece</p>
  <p class="price">$00</p>
</article>
