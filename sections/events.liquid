{%- assign today = 'now' | date: '%Y-%m-%d' -%}
<section class="block" id="{{ section.settings.anchor | default: 'events' }}">
  <div class="wrap">
    <div class="sec-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="caps">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>

    {%- assign shown = 0 -%}
    <ul class="events">
      {%- for block in section.blocks -%}
        {%- assign date = block.settings.date | strip -%}
        {%- if section.settings.hide_past and date != blank and date < today -%}{%- continue -%}{%- endif -%}
        {%- if shown >= section.settings.max_events -%}{%- break -%}{%- endif -%}
        {%- assign shown = shown | plus: 1 -%}
        <li {{ block.shopify_attributes }}>
          {%- if date != blank -%}
            <time class="date" datetime="{{ date }}"><span class="caps">{{ date | date: '%b' }}</span><b>{{ date | date: '%-d' }}</b></time>
          {%- else -%}
            <span class="date"><span class="caps">Date</span><b>TBA</b></span>
          {%- endif -%}
          <div>
            <h3>{{ block.settings.title }}</h3>
            {%- if block.settings.details != blank -%}<p class="muted">{{ block.settings.details }}</p>{%- endif -%}
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
    {%- if shown == 0 -%}
      <p class="muted">{{ section.settings.empty_text }}</p>
    {%- endif -%}

    {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
      <p class="foot"><a class="btn line" href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a></p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Events",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Section ID (for #links)", "default": "events" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Events & Pop-ups" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find us out and about." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "We bring a rack or two of our favorite finds to markets and pop-ups around Omaha. Come see them in person." },
    { "type": "range", "id": "max_events", "label": "Events to show", "min": 1, "max": 20, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "hide_past", "label": "Hide events once their date has passed", "default": true },
    { "type": "text", "id": "empty_text", "label": "Text when there are no upcoming events", "default": "No events on the calendar right now. Check back soon." },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "See all events" },
    { "type": "text", "id": "link_url", "label": "Button link", "info": "e.g. /pages/events. Leave blank to hide the button, e.g. on the events page itself." }
  ],
  "blocks": [
    {
      "type": "event",
      "name": "Event",
      "settings": [
        { "type": "text", "id": "date", "label": "Date", "info": "Year-month-day, e.g. 2026-10-10" },
        { "type": "text", "id": "title", "label": "Event name", "default": "Event name" },
        { "type": "text", "id": "details", "label": "Day, time & place", "default": "Saturday · 10:00 – 4:00 · Venue name, Omaha" },
        { "type": "textarea", "id": "text", "label": "Description" }
      ]
    }
  ],
  "presets": [{ "name": "Events" }]
}
{% endschema %}
