<section class="block first password">
  <div class="wrap narrow center">
    <div class="seal">{% render 'logo', class: 'logo hero-img', alt: 'Heirloom Co. seal: Omaha, NE' %}</div>
    <h1 class="h2">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p class="muted">{{ shop.password_message }}</p>{%- endif -%}

    {%- form 'customer', class: 'search-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p>You're on the list. We'll email you when the doors open.</p>
      {%- else -%}
        <label class="visually-hidden" for="pw-email">Email</label>
        <input id="pw-email" type="email" name="contact[email]" placeholder="Your email" required>
        <button type="submit" class="btn solid">Notify me</button>
      {%- endif -%}
    {%- endform -%}

    <details class="pw-login">
      <summary class="small">Store owner? Enter password</summary>
      {%- form 'storefront_password', class: 'search-form' -%}
        {{ form.errors | default_errors }}
        <label class="visually-hidden" for="pw">Password</label>
        <input id="pw" type="password" name="password" placeholder="Password">
        <button type="submit" class="btn line">Enter</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon." }
  ]
}
{% endschema %}
