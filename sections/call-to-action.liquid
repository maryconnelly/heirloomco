<section class="block racks">
  <div class="wrap center">
    <div class="sec-head tight" style="justify-content:center">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="caps">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>
    {%- if section.settings.text != blank -%}
      <p class="muted" style="max-width:34em;margin:0 auto 28px">{{ section.settings.text }}</p>
    {%- endif -%}
    <div class="actions" style="justify-content:center">
      {%- if section.settings.button_1_label != blank -%}
        <a class="btn solid" href="{{ section.settings.button_1_link }}">{{ section.settings.button_1_label }}</a>
      {%- endif -%}
      {%- if section.settings.button_2_label != blank -%}
        <a class="btn line" href="{{ section.settings.button_2_link }}">{{ section.settings.button_2_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Call to action",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Host a pop-up" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Want us at your event?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "We love setting up at markets, fairs, shops and private events. Tell us a little about yours and we'll be in touch." },
    { "type": "text", "id": "button_1_label", "label": "First button label", "default": "Get in touch" },
    { "type": "text", "id": "button_1_link", "label": "First button link", "default": "/pages/contact" },
    { "type": "text", "id": "button_2_label", "label": "Second button label", "default": "Shop online" },
    { "type": "text", "id": "button_2_link", "label": "Second button link", "default": "/collections/all" }
  ],
  "presets": [{ "name": "Call to action" }]
}
{% endschema %}
