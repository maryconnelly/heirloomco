<section class="page-head">
  <div class="wrap">
    {%- if section.settings.eyebrow != blank -%}<span class="caps">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h1>{{ section.settings.heading | default: page.title }}{% if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent }}</em>{% endif %}</h1>
    {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text }}</p>{%- endif -%}
  </div>
</section>

<section class="block">
  <div class="wrap contact">
    {%- form 'contact', class: 'form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-status" role="status">{{ section.settings.success_text }}</p>
      {%- endif -%}
      {%- if form.errors -%}
        <div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="row">
        <label><span>Name</span><input type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}" required></label>
        <label><span>Email</span><input type="email" name="contact[email]" autocomplete="email" value="{{ form.email }}" required></label>
      </div>
      {%- assign topics = section.settings.topics | split: ',' -%}
      {%- if topics.size > 0 -%}
        <label>
          <span>About</span>
          <select name="contact[Topic]">
            {%- for topic in topics -%}<option>{{ topic | strip }}</option>{%- endfor -%}
          </select>
        </label>
      {%- endif -%}
      <label><span>Message</span><textarea name="contact[body]" required>{{ form.body }}</textarea></label>
      <button class="btn solid" type="submit">Send message</button>
    {%- endform -%}

    <aside>
      <div class="sec-head tight">
        <div>
          <span class="caps">{{ section.settings.aside_heading }}</span>
        </div>
      </div>
      {%- if section.settings.aside_text != blank -%}<p class="muted">{{ section.settings.aside_text }}</p>{%- endif -%}
      {%- if section.settings.aside_button_label != blank -%}
        <div class="actions">
          <a class="btn line" href="{{ section.settings.aside_button_link }}">{{ section.settings.aside_button_label }}</a>
        </div>
      {%- endif -%}
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Contact" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Say" },
    { "type": "text", "id": "heading_accent", "label": "Heading (green italic ending)", "default": "hello." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Questions about a piece, an event, or anything else? Send a note and we'll get back to you." },
    { "type": "text", "id": "topics", "label": "Topics", "info": "Separate with commas. Leave blank to hide the dropdown.", "default": "A piece in the shop, Events & pop-ups, Something else" },
    { "type": "text", "id": "success_text", "label": "Message after sending", "default": "Thanks for your note! We'll get back to you soon." },
    { "type": "text", "id": "aside_heading", "label": "Side heading", "default": "Find us in person" },
    { "type": "textarea", "id": "aside_text", "label": "Side text", "default": "Heirloom Co. is an online shop based in Omaha, Nebraska. To see our finds in person, catch us at a market or pop-up around town." },
    { "type": "text", "id": "aside_button_label", "label": "Side button label", "default": "Upcoming events" },
    { "type": "text", "id": "aside_button_link", "label": "Side button link", "default": "/pages/events" }
  ]
}
{% endschema %}
